        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n/* AA-4 - Misura della chat HubSpot (test A/B dell'apertura automatica da computer).\n   Invia al dataLayer l'evento \"chat_hubspot\" con chat_azione = mostrata | aperta | interazione | conversazione | chiusa.\n   - aperta: la finestra passa da pulsante (100x96) a finestra intera. chat_modo: utente (clic sul pulsante),\n     automatica (senza interazione, dopo almeno 4 s: il trigger della chatflow) o ripresa (senza interazione nei primi\n     4 s: HubSpot riapre una finestra lasciata aperta nella pagina precedente). Si misura dalle dimensioni del\n     contenitore, l'unico segnale affidabile per l'apertura automatica.\n   - chiusa: la finestra torna pulsante; chat_secondi_aperta = durata; chat_interazione = si se, oltre al clic di\n     chiusura (che HubSpot conta come interazione), c'è stato almeno un altro clic o una conversazione.\n   - chat_secondi: secondi dal caricamento della pagina.\n   Gli stessi momenti vanno a Microsoft Clarity come eventi e tag di sessione, per filtrare le registrazioni.\n   Nessun cookie, nessun dato personale, nessuna richiesta ad altri server. */\n(function () {\n  if (window.__kosChatMisura) return;\n  window.__kosChatMisura = true;\n  var t0 = Date.now(), mostrata = false, aperta = 0, modo = '', interagito = false, interazioniQui = 0, conversazioneQui = false, aperto = false;\n  var dl = window.dataLayer = window.dataLayer || [];\n  function sec(ms) { return Math.round(ms / 1000); }\n  function clarityEvento(nome, tag) {\n    try {\n      if (typeof window.clarity === 'function') {\n        window.clarity('event', nome);\n        if (tag) window.clarity('set', tag[0], tag[1]);\n      }\n    } catch (e) {}\n  }\n  function invia(azione, extra) {\n    var o = { event: 'chat_hubspot', chat_azione: azione, chat_secondi: sec(Date.now() - t0),\n              chat_modo: '', chat_secondi_aperta: '', chat_interazione: '' };\n    for (var k in extra) o[k] = extra[k];\n    dl.push(o);\n  }\n  function osserva(c) {\n    if (!window.ResizeObserver) return;\n    new ResizeObserver(function () {\n      var r = c.getBoundingClientRect(), ora = r.width >= 300 && r.height >= 400;\n      if (ora && !aperto) {\n        aperto = true; aperta = Date.now(); interazioniQui = 0; conversazioneQui = false;\n        // l'evento di interazione dell'SDK può arrivare subito dopo il ridimensionamento: si attende un attimo\n        setTimeout(function () {\n          modo = interagito ? 'utente' : (aperta - t0 < 4000 ? 'ripresa' : 'automatica');\n          invia('aperta', { chat_modo: modo });\n          clarityEvento('chat_aperta_' + modo, ['chat_aperta', modo]);\n        }, 600);\n      } else if (!ora && aperto && r.width > 0) {\n        aperto = false;\n        var durata = sec(Date.now() - aperta), usata = interazioniQui >= 2 || conversazioneQui;\n        var esito = usata ? 'dopo_uso' : (durata <= 5 ? 'subito' : 'senza_uso');\n        invia('chiusa', { chat_modo: modo, chat_secondi_aperta: durata, chat_interazione: usata ? 'si' : 'no' });\n        clarityEvento('chat_chiusa_' + esito, ['chat_chiusa', esito]);\n        interagito = false;\n      }\n    }).observe(c);\n  }\n  function collega() {\n    var api = window.HubSpotConversations;\n    if (!api || !api.on || api.__kosMisura) return;\n    api.__kosMisura = true;\n    function segnaMostrata() { if (!mostrata) { mostrata = true; invia('mostrata'); } }\n    api.on('widgetLoaded', segnaMostrata);\n    api.on('userInteractedWithWidget', function () {\n      interagito = true; if (aperto) interazioniQui++; invia('interazione', { chat_modo: aperto ? modo : '' });\n    });\n    api.on('conversationStarted', function () {\n      conversazioneQui = true; invia('conversazione', { chat_modo: modo }); clarityEvento('chat_conversazione', ['chat_conversazione', 'si']);\n    });\n    if (api.widget && api.widget.status && api.widget.status().loaded) segnaMostrata();\n  }\n  window.hsConversationsOnReady = window.hsConversationsOnReady || [];\n  window.hsConversationsOnReady.push(collega);\n  collega();\n  var tentativi = 0, attesa = setInterval(function () {\n    var c = document.getElementById('hubspot-messages-iframe-container');\n    if (c) { clearInterval(attesa); osserva(c); }\n    else if (++tentativi > 60) clearInterval(attesa);\n  }, 500);\n})();\n</script>"
